digraph G { graph [bgcolor="transparent", pad=.25, nodesep=.55, ranksep=.9, fontname="Arial", fontsize=14]; node [fontname="Arial", fontsize=12, color="#7961AD", penwidth=1.5]; edge [fontname="Arial", fontsize=10, color="#806AA8", fontcolor="#554675", arrowsize=.65, penwidth=1.5];
 graph [rankdir=LR, ranksep=1.25, nodesep=.5];
node [shape=plain];
Usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ id: UUID<BR ALIGN="LEFT"/>+ nombre: String<BR ALIGN="LEFT"/>+ email: String<BR ALIGN="LEFT"/>+ rol: String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ iniciarSesion()<BR ALIGN="LEFT"/>+ publicarResena()</FONT></TD></TR></TABLE>>];
Administrador [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Administrador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">—</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ registrarCalcetin()<BR ALIGN="LEFT"/>+ actualizarStock()<BR ALIGN="LEFT"/>+ modificarPrecio()</FONT></TD></TR></TABLE>>];
Cliente [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Cliente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">—</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ agregarAlCarrito()<BR ALIGN="LEFT"/>+ finalizarPedido()</FONT></TD></TR></TABLE>>];
Calcetin [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Calcetin</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ id: String<BR ALIGN="LEFT"/>+ nombre: String<BR ALIGN="LEFT"/>+ precio: Decimal<BR ALIGN="LEFT"/>+ stock: int<BR ALIGN="LEFT"/>+ tallas: String[]<BR ALIGN="LEFT"/>+ imagen: String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ hayStock(cantidad): bool</FONT></TD></TR></TABLE>>];
Categoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Categoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ id: String<BR ALIGN="LEFT"/>+ nombre: String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ clasificar()</FONT></TD></TR></TABLE>>];
ObraTematica [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>ObraTematica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ titulo: String<BR ALIGN="LEFT"/>+ tipo: String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ asociar()</FONT></TD></TR></TABLE>>];
Carrito [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Carrito</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">—</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ agregar()<BR ALIGN="LEFT"/>+ modificarCantidad()<BR ALIGN="LEFT"/>+ calcularTotal()</FONT></TD></TR></TABLE>>];
ItemCarrito [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>ItemCarrito</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ talla: String<BR ALIGN="LEFT"/>+ cantidad: int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ subtotal(): Decimal</FONT></TD></TR></TABLE>>];
Pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ id: String<BR ALIGN="LEFT"/>+ fecha: DateTime<BR ALIGN="LEFT"/>+ clienteInvitado: String<BR ALIGN="LEFT"/>+ total: Decimal<BR ALIGN="LEFT"/>+ estado: String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ simularPago(): bool</FONT></TD></TR></TABLE>>];
DetallePedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>DetallePedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ talla: String<BR ALIGN="LEFT"/>+ cantidad: int<BR ALIGN="LEFT"/>+ precioUnitario: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">—</FONT></TD></TR></TABLE>>];
Resena [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#AB98C8" BGCOLOR="#F8F5FF"><TR><TD BGCOLOR="#35235F" ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="white" POINT-SIZE="14"><B>Resena</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ puntuacion: 1..5<BR ALIGN="LEFT"/>+ comentario: String<BR ALIGN="LEFT"/>+ fecha: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT COLOR="#25203E">+ publicar()</FONT></TD></TR></TABLE>>];
Usuario -> Administrador [arrowhead=empty, dir=back, label="hereda"];
Usuario -> Cliente [arrowhead=empty, dir=back, label="hereda"];
Categoria -> Calcetin [arrowtail=odiamond, dir=both, arrowhead=none, taillabel="1", headlabel="0..*", label="clasifica"];
ObraTematica -> Calcetin [arrowhead=vee, taillabel="1", headlabel="0..*", label="inspira"];
Usuario -> Resena [arrowhead=none, taillabel="1", headlabel="0..*", label="escribe"];
Resena -> Calcetin [arrowhead=vee, taillabel="0..*", headlabel="1", label="valora"];
Usuario -> Carrito [arrowhead=none, taillabel="0..1", headlabel="0..1",label="usa"];
Carrito -> ItemCarrito [arrowtail=diamond,dir=both,arrowhead=none,taillabel="1",headlabel="0..*",label="contiene"];
ItemCarrito -> Calcetin [arrowhead=vee, taillabel="0..*", headlabel="1", label="selecciona"];
Usuario -> Pedido [arrowhead=none,taillabel="0..1",headlabel="0..*",label="realiza"];
Pedido -> DetallePedido [arrowtail=diamond,dir=both,arrowhead=none,taillabel="1",headlabel="1..*",label="contiene"];
DetallePedido -> Calcetin [arrowhead=vee,taillabel="0..*",headlabel="1",label="incluye"];
}
